# ===================================================================
# TURSO CLOUD SQLITE CONFIGURATION
# ===================================================================
# Database URL format:
# libsql://[database-name]-[org-name].turso.io or https://...
TURSO_DATABASE_URL=libsql://your-database-name.turso.io

# Turso Database Authorization Token (JWT)
TURSO_AUTH_TOKEN=your_turso_jwt_auth_token_here
